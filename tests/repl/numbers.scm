; Fixnum arithmetic, any number of arguments.
(+)
(+ 1 2 3)
(- 5)
(- 10 3 2)
(*)
(* 3 -4)
(* 1152921504606846975 -1)
(- -1152921504606846975 1)

; Comparison, any number of arguments.
(= 1 1 1)
(= 1 1 2)
(< 1 2 3)
(< 1 3 2)

; Overflow and type errors.
(+ 1152921504606846975 1)
(- -1152921504606846976)
(* 1152921504606846975 2)
(+ 1 #t)

; Other comparisons, quotient and remainder, and predicates.
(> 3 2 1)
(> 3 3)
(<= 1 1 2)
(<= 2 1)
(>= 2 2 1)
(>= 2 3)
(quotient 7 2)
(quotient -7 2)
(remainder 7 2)
(remainder -7 2)
(fixnum? 5)
(fixnum? 'a)
(zero? 0)
(zero? 3)
(quotient 1 0)
(<= 1 'a)

; number->string, in a radix.
(number->string 0)
(number->string 42)
(number->string -42)
(number->string 42 10)
(number->string 255 16)
(number->string 255 2)
(number->string -8 8)
(number->string 1152921504606846975)
(number->string -1152921504606846976 2)
(number->string 'a)
(number->string 5 3)
(number->string 5 'x)

; Flonums, and string->number: a radix, a prefix overriding it, and #f for a
; non-number.
(number->string 1.5)
(number->string -0.0 10)
(string->number "42")
(string->number "-1.5e2")
(string->number "ff" 16)
(string->number "#b101" 16)
(string->number "101" 2)
(string->number "+inf.0")
(string->number "abc")
(string->number "")
(string->number "1/2")
(number->string 1.5 2)
(string->number 'a)
(string->number "1" 3)
(string->number "99999999999999999999")
(string->number "#e1.5")
