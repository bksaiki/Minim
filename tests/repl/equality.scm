; eq? is identity.
(eq? 'a 'a)
(eq? (cons 1 2) (cons 1 2))

; eqv? is eq?, except that flonums are compared by their bits.
(eqv? 'a 'a)
(eqv? 1 1)
(eqv? #\a #\a)
(eqv? '() '())
(eqv? (cons 1 2) (cons 1 2))
(eqv? "a" "a")
(eqv? 1.5 1.5)
(eq? 1.5 1.5)
(eqv? 0.0 -0.0)
(eqv? +nan.0 +nan.0)
(eqv? +inf.0 +inf.0)
(eqv? 1 1.0)
(eqv? 0.1 (string->number "0.1"))
(memv 2.0 '(1 2 2.0 3))
(assv 2.0 '((2 . a) (2.0 . b)))
(case 2.0 ((1 2) 'exact) ((2.0) 'inexact) (else 'none))

; equal? compares flonums as eqv? does.
(equal? '(1.5 #(2.5)) (list 1.5 (vector 2.5)))
(equal? 0.0 -0.0)
(equal? 1 1.0)
(= (equal-hash '(1.5 "a")) (equal-hash (list 1.5 "a")))
(= (equal-hash 1.0) (equal-hash 1))

; equal? compares pairs, vectors, and strings by content.
(equal? 1 1)
(equal? 'a 'b)
(equal? '(1 2 3) (list 1 2 3))
(equal? '(1 2 3) '(1 2))
(equal? '(1 . 2) (cons 1 2))
(equal? '(1 . 2) '(1 . 3))
(equal? '((1 (2)) #(3)) (list (list 1 (list 2)) (vector 3)))
(equal? #(1 #(2 "x")) (vector 1 (vector 2 "x")))
(equal? #(1 2) #(1 2 3))
(equal? "caf\xe9;" "caf\xe9;")
(equal? "abc" "abd")
(equal? "" "")
(equal? 2 "2")
(equal? '(1) #(1))
(define p (cons 1 2))
(equal? p p)

; Bytevectors are equal? by their bytes.
(equal? #u8(1 2 3) (list->vector '(1 2 3)))
(equal? #u8(1 2 3) #u8(1 2 3))
(equal? #u8(1 2) #u8(1 2 3))
(equal? #u8() #u8())
(equal? '(#u8(255)) '(#u8(255)))
(= (equal-hash #u8(1 2)) (equal-hash #u8(1 2)))
(eq? #u8(1) #u8(1))

; equal? terminates on cyclic data: lists of different periods, vectors
; holding themselves, cycles through cars.
(define (circular . xs)
  (let ((lst (list-copy xs)))
    (set-cdr! (list-tail lst (- (length lst) 1)) lst)
    lst))
(define c1 (circular 1 2))
(list (equal? c1 c1) (equal? c1 (circular 1 2)) (equal? c1 (circular 1 2 1 2))
      (equal? (circular 1 2 1 2) c1) (equal? c1 (circular 1 2 1 3)) (equal? c1 (circular 1)))
(define (self-vector x)
  (let ((v (vector x #f)))
    (vector-set! v 1 v)
    v))
(list (equal? (self-vector 1) (self-vector 1)) (equal? (self-vector 1) (self-vector 2)))
(define (self-car . rest)
  (let ((p (cons #f rest)))
    (set-car! p p)
    p))
(list (equal? (self-car) (self-car)) (equal? (self-car) (self-car 1)))
(define (self-pair)
  (let ((p (list #f)))
    (set-car! p p)
    (set-cdr! p p)
    p))
(equal? (self-pair) (self-pair))

; Long acyclic lists, past the budget, compare as before.
(define (iota n)
  (let loop ((i (- n 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(list (equal? (iota 5000) (iota 5000)) (equal? (iota 5000) (append (iota 4999) '(x))))

; boolean=? and symbol=?: by identity, of one or more arguments.
(boolean=? #t #t)
(boolean=? #f #f #f)
(boolean=? #t #f)
(boolean=? #f #f #t)
(symbol=? 'a 'a)
(symbol=? 'a 'a 'a)
(symbol=? 'a 'A)
(symbol=? 'a (string->symbol "a"))
(boolean=? #t 1)
(symbol=? 'a "a")
