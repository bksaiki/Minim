; Uninterned symbols print like their names but are distinct.
(define g (gensym "x"))
g
(symbol? g)
(eq? g 'x)
(eq? g (gensym "x"))
(eq? (string->symbol (symbol->string g)) 'x)
(eq? (gensym) (gensym))
(gensym 'x)

; Symbols and strings.
(symbol? 'a)
(symbol? "a")
(symbol->string 'abc)
(string->symbol "abc")
(eq? (string->symbol "abc") 'abc)
(symbol->string "abc")

; Property lists, keys compared by eq?.
(define env (vector 'env))
(%getprop 'p env #f)
(%putprop! 'p env 1)
(%putprop! 'p 'k 2)
(%getprop 'p env #f)
(%getprop 'p 'k #f)
(%getprop 'p (vector 'env) #f)
(%getprop 'q env #f)
(%putprop! 'p env 3)
(%getprop 'p env #f)
(%remprop! 'p env)
(%getprop 'p env 'none)
(%getprop 'p 'k #f)
(%remprop! 'p env)
(%getprop (gensym "p") 'k #f)
(%getprop "p" 'k #f)
(%putprop! 1 'k 2)
(%remprop! '(p) 'k)
