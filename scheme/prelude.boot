(%define-macro! 'define-record-type '(syntax-rules () ((_ type (ctor cfield ...) pred (field accessor . modifier) ...) (begin (define type (%make-record-type 'type '(field ...))) (define ctor (let ((make (%record-constructor type '(cfield ...)))) (lambda (cfield ...) (make (list cfield ...))))) (define pred (%record-predicate type)) (%define-record-field type field accessor . modifier) ...))))
(%define-macro! '%define-record-field '(syntax-rules () ((_ type field accessor) (define accessor (%record-accessor type 'field 'accessor))) ((_ type field accessor modifier) (begin (define accessor (%record-accessor type 'field 'accessor)) (define modifier (%record-modifier type 'field 'modifier))))))
(define <environment> (%make-record-type '<environment> '(top mutable?)))
(define %make-environment (let-values (((make.1) (%record-constructor <environment> '(top mutable?)))) (lambda (top.1 mutable?.1) (make.1 (list top.1 mutable?.1)))))
(define %environment? (%record-predicate <environment>))
(define %environment-top (%record-accessor <environment> 'top '%environment-top))
(define %environment-mutable? (%record-accessor <environment> 'mutable? '%environment-mutable?))
(define %environments '())
(define %copy-sets (lambda (x.1) (if (pair? x.1) (cons (%copy-sets (car x.1)) (%copy-sets (cdr x.1))) x.1)))
(define environment (lambda sets.1 (let-values (((temp.1) (assoc sets.1 %environments))) (if temp.1 (cdr temp.1) (begin (let-values (((top.1) (%make-top 'library #f))) (%import! top.1 sets.1) (let-values (((env.1) (%make-environment top.1 #f))) (set! %environments (cons (cons (%copy-sets sets.1) env.1) %environments)) env.1)))))))
(define interaction-environment (make-parameter (%make-environment %interaction-env #t) (lambda (env.1) (if (%environment? env.1) (if #f #f) (begin (error "interaction-environment: not an environment" env.1))) env.1)))
(define %expand-in (lambda (x.1 env.1) (let-values (((top.1) (%environment-top env.1))) (if (%environment-mutable? env.1) (%expand-top x.1 top.1) (%expand-expr x.1 top.1)))))
(define eval (lambda (x.1 env.1) (if (%environment? env.1) (if #f #f) (begin (error "eval: not an environment" env.1))) (%eval-expanded (%expand-in x.1 env.1))))
(define %expand (lambda (x.1) (%expand-in x.1 (interaction-environment))))
(define %interaction-label! (lambda (id.1) (let-values (((env.1) (interaction-environment))) (if (%environment-mutable? env.1) (if #f #f) (begin (error "minim_define: immutable interaction environment" id.1))) (%top-define! (%environment-top env.1) id.1))))
(define scheme-report-environment (lambda (version.1) (if (eqv? version.1 5) (if #f #f) (begin (error "scheme-report-environment: not version 5" version.1))) (environment '(scheme r5rs))))
(define null-environment (lambda (version.1) (if (eqv? version.1 5) (if #f #f) (begin (error "null-environment: not version 5" version.1))) (environment (append '(only (scheme r5rs)) (map car (filter (lambda (b.1) (let-values (((x.1) (procedure? (cdr b.1)))) (if x.1 x.1 (not (%bound? (cdr b.1)))))) (%library-exports '(scheme r5rs))))))))
(define %current-port (lambda (port.1 ok?.1 msg.1) (make-parameter port.1 (lambda (p.1) (if (if (port? p.1) (ok?.1 p.1) #f) (if #f #f) (begin (error msg.1 p.1))) p.1))))
(define current-input-port (%current-port (%standard-port 0) input-port? "current-input-port: not an input port"))
(define current-output-port (%current-port (%standard-port 1) output-port? "current-output-port: not an output port"))
(define current-error-port (%current-port (%standard-port 2) output-port? "current-error-port: not an output port"))
(define %port-arg (lambda (args.1 current.1 msg.1) (if (null? args.1) (begin (current.1)) (if (null? (cdr args.1)) (begin (car args.1)) (begin (error msg.1 args.1))))))
(define write (lambda (x.1 . port.1) (%write x.1 (%port-arg port.1 current-output-port "write: too many arguments"))))
(define write-simple (lambda (x.1 . port.1) (%write x.1 (%port-arg port.1 current-output-port "write-simple: too many arguments"))))
(define display (lambda (x.1 . port.1) (%display x.1 (%port-arg port.1 current-output-port "display: too many arguments"))))
(define read (lambda port.1 (%read (%port-arg port.1 current-input-port "read: too many arguments"))))
(define read-char (lambda port.1 (%read-char (%port-arg port.1 current-input-port "read-char: too many arguments"))))
(define peek-char (lambda port.1 (%peek-char (%port-arg port.1 current-input-port "peek-char: too many arguments"))))
(define read-line (lambda port.1 (%read-line (%port-arg port.1 current-input-port "read-line: too many arguments"))))
(define read-string (lambda (k.1 . port.1) (%read-string k.1 (%port-arg port.1 current-input-port "read-string: too many arguments"))))
(define char-ready? (lambda port.1 (%char-ready? (%port-arg port.1 current-input-port "char-ready?: too many arguments"))))
(define write-char (lambda (c.1 . port.1) (%write-char c.1 (%port-arg port.1 current-output-port "write-char: too many arguments"))))
(define newline (lambda port.1 (%write-char #\newline (%port-arg port.1 current-output-port "newline: too many arguments"))))
(define flush-output-port (lambda port.1 (%flush-output-port (%port-arg port.1 current-output-port "flush-output-port: too many arguments"))))
(define write-string (lambda (s.1 . args.1) (let-values (((port.1) (if (pair? args.1) (car args.1) (current-output-port))) ((bounds.1) (if (pair? args.1) (cdr args.1) '()))) (if (null? bounds.1) (begin (%write-string s.1 port.1 0 #f)) (if (null? (cdr bounds.1)) (begin (%write-string s.1 port.1 (car bounds.1) #f)) (if (null? (cddr bounds.1)) (begin (%write-string s.1 port.1 (car bounds.1) (cadr bounds.1))) (begin (error "write-string: too many arguments" args.1))))))))
(define call-with-port (lambda (port.1 proc.1) (call-with-values (lambda () (proc.1 port.1)) (lambda vals.1 (close-port port.1) (apply values vals.1)))))
(define call-with-input-file (lambda (path.1 proc.1) (call-with-port (open-input-file path.1) proc.1)))
(define call-with-output-file (lambda (path.1 proc.1) (call-with-port (open-output-file path.1) proc.1)))
(define with-input-from-file (lambda (path.1 thunk.1) (call-with-input-file path.1 (lambda (port.1) (%parameterize (list current-input-port) (list port.1) (lambda () (thunk.1)))))))
(define with-output-to-file (lambda (path.1 thunk.1) (call-with-output-file path.1 (lambda (port.1) (%parameterize (list current-output-port) (list port.1) (lambda () (thunk.1)))))))
