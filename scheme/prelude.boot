(%define-system-library '(minim) (append (%exported-names '((scheme base) (scheme eval) (scheme file) (scheme load) (scheme process-context) (scheme read) (scheme repl) (scheme write))) '(null-environment scheme-report-environment) '(collect collect-generation-radix collect-maximum-generation collect-nursery-bytes define-library equal-hash filter fixnum? fold fold-right gensym import parameter? string-hash letrec-values)))
